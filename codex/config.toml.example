# Codex용 Playwright MCP 예시.
# 이 파일을 저장소의 .codex/config.toml 로 복사하지 않는다.
# 프로젝트를 trust 하면 그 파일이 바로 적용되어, 경로를 고치기 전에 브라우저가 뜬다.
# ~/.codex/config.toml 에 아래 [mcp_servers.playwright] 블록만 합친다.
#
# 형식 근거:
# - https://learn.chatgpt.com/docs/config-file/config-reference
# - https://playwright.dev/mcp/clients/other-clients
# - https://github.com/microsoft/playwright-mcp#user-profile
#
# Codex는 args를 셸 없이 넘기므로 ~ 와 ${HOME} 이 펼쳐지지 않는다.
# node scripts/login.mjs --print-profile 이 출력한 절대 경로로 바꾼다.
# --headless, --isolated, --storage-state, --save-session 은 넣지 않는다.
# 헤드 모드가 기본값이고, 프로필은 디스크에 남는다.
# 같은 프로필은 브라우저 하나만 쓸 수 있다.

[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp@latest", "--user-data-dir", "/REPLACE_WITH_ABSOLUTE_HOME/.mycl-profile"]
enabled = true
